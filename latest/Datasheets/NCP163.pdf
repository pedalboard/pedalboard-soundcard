         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NCP163 - LDO Regulator - Ultra-Low Noise, High PSRR, RF and Analog Circuits, 250 mA</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The NCP163 is a next generation of high PSRR, ultraâˆ’low noise&#xA;LDO capable of supplying 250 mA output current. Designed to meet&#xA;the requirements of RF and sensitive analog circuits, the NCP163&#xA;device provides ultraâˆ’low noise, high PSRR and low quiescent&#xA;current. The device also offer excelent load/line transients. The&#xA;NCP163 is designed to work with a 1  F input and a 1  F output&#xA;ceramic capacitor.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:e2c502ce-3ce7-4f2e-9d7b-e862706da03d</xmpMM:DocumentID>
